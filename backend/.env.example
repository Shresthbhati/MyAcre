# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres, hosted on Supabase — no local Postgres install needed.
# Supabase dashboard > this project > Connect > "Transaction pooler" connection
# string (use the pooler, not the direct connection — it's IPv4-reachable and
# works from anywhere; the direct connection is IPv6-only on most plans).
# Append &pgbouncer=true so Prisma's interactive transactions (used by the
# atomic buy endpoint) work correctly against the pooler.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the ENTIRE downloaded JSON file contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Blockchain (Phase 3) — see /contracts. Deploy PropertyToken.sol first
# (npm run deploy:amoy in /contracts), then fill these in. The backend calls
# on-chain best-effort: if these are left blank, everything still works
# off-chain (Postgres stays the source of truth), just without the
# on-chain mint step.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
# Same private key you used as DEPLOYER_PRIVATE_KEY in contracts/.env — that
# wallet is the contract's authorized minter.
MINTER_PRIVATE_KEY=
# Any random 32-byte hex string, used to encrypt custodial user wallet keys
# at rest. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required unless DEMO_MODE=true — the server refuses to start without it.
WALLET_ENCRYPTION_KEY=

# Set to "true" only for local demos to allow an insecure default wallet
# encryption key when WALLET_ENCRYPTION_KEY isn't set. Never set in production.
DEMO_MODE=
