# Copy this file to .env and fill in real values. .env is git-ignored.

# SQLite by default — a local file, zero external setup. Good enough for
# development and this demo's scale (see prisma/schema.prisma for why).
# To point at a real Postgres instead: change schema.prisma's datasource
# provider back to "postgresql" and set this to a Postgres connection string.
DATABASE_URL=file:./dev.db

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the ENTIRE downloaded JSON file contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Blockchain (Phase 3) — see /contracts. Deploy PropertyToken.sol first
# (npm run deploy:amoy in /contracts), then fill these in. The backend calls
# on-chain best-effort: if these are left blank, everything still works
# off-chain (Postgres stays the source of truth), just without the
# on-chain mint step.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
# Same private key you used as DEPLOYER_PRIVATE_KEY in contracts/.env — that
# wallet is the contract's authorized minter.
MINTER_PRIVATE_KEY=
# Any random 32-byte hex string, used to encrypt custodial user wallet keys
# at rest. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=
