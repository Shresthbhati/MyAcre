# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# Neon (or any Postgres) connection string.
# Neon: neon.tech > New Project > copy the "Connection string" (use the pooled one).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the ENTIRE downloaded JSON file contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
