# Copy this file to .env and fill in real values. .env is git-ignored.

# Neon (or any Postgres) connection string.
# Neon: neon.tech > New Project > copy the "Connection string" (use the pooled
# one — hostname has "-pooler" in it). Append &pgbouncer=true so Prisma's
# interactive transactions (used for the atomic buy endpoint) work correctly
# against Neon's PgBouncer proxy — without it, multi-step transactions can
# fail with "Transaction not found" once total round-trip time adds up.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the ENTIRE downloaded JSON file contents here as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
