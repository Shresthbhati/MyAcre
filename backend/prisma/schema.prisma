generator client {
  provider = "prisma-client-js"
}

// Postgres, hosted on Supabase — a real, always-on database with zero local
// setup (no Docker, no manual Postgres install). Money and area/sqft fields
// use Postgres's native Decimal, not Float — repeated increments to columns
// like Plot.soldSqFt would otherwise accumulate IEEE-754 rounding error.
// Every read site converts back to a plain JS number (Number(...)) before
// it reaches the API response.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TitleStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Tracks whether a purchase's on-chain settlement actually happened, kept
// separate from TransactionStatus: a transaction can be COMPLETED off-chain
// (payment + ownership recorded in Postgres) while its blockchain leg is
// unconfirmed — the app must never conflate the two. See
// backend/src/lib/blockchain.js#classifySettlement.
enum BlockchainStatus {
  NOT_CONFIGURED
  CONFIRMED
  RECONCILIATION_REQUIRED
}

enum PlotStatus {
  AVAILABLE
  PARTIAL
  SOLD
  EXCLUDED
}

model User {
  id                        String    @id @default(uuid())
  firebaseUid               String    @unique
  email                     String    @unique
  name                      String?
  role                      UserRole  @default(USER)
  kycStatus                 KycStatus @default(UNVERIFIED)
  kycPan                    String?
  walletAddress             String?
  walletPrivateKeyEncrypted String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  listings     Listing[]     @relation("ListingOwner")
  holdings     Holding[]
  plotHoldings PlotHolding[]
  transactions Transaction[] @relation("TransactionBuyer")
  documents    Document[]

  @@map("users")
}

model Listing {
  id                   String      @id @default(uuid())
  ownerId              String
  owner                User        @relation("ListingOwner", fields: [ownerId], references: [id])
  title                String
  description          String
  city                 String
  latitude             Float
  longitude            Float
  titleDeedNumber      String
  totalValue           Decimal     @db.Decimal(14, 2)
  areaSqFt             Decimal     @db.Decimal(14, 2)
  pricePerSqFt         Decimal     @db.Decimal(14, 2)
  totalTokens          Int
  pricePerToken        Decimal     @db.Decimal(14, 2)
  sqFtPerToken         Decimal     @db.Decimal(14, 2)
  gridRows             Int         @default(4)
  gridCols             Int         @default(5)
  imageSeed            String
  titleStatus          TitleStatus @default(PENDING)
  titleRejectionReason String?
  contractAddress      String?
  onChainTxHash        String?
  // Admin kill switch, independent of titleStatus: a listing can be VERIFIED
  // (its title checked out) and still get frozen later — evidence turned out
  // to be disputed, a legal hold, fraud report, etc. Frozen blocks new
  // purchases without touching the verification record itself.
  frozen               Boolean     @default(false)
  frozenReason         String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  holdings     Holding[]
  plots        Plot[]
  transactions Transaction[]
  documents    Document[]

  @@map("listings")
}

// Evidence file attached to a listing (deed scan, survey, etc). The hash is
// computed server-side from the actual uploaded bytes at upload time — it's
// what lets a later re-check confirm the stored file hasn't been swapped or
// altered. No versioning yet: each upload is its own row, nothing is
// overwritten in place.
model Document {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  filename    String
  mimeType    String
  size        Int
  sha256      String
  storagePath String
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@map("documents")
}

// One row per grid cell shown on the map. `sellable=false` (status EXCLUDED)
// marks cells that overlap roads / setbacks / common area — an owner draws
// these out when listing, and they're never purchasable.
model Plot {
  id        String     @id @default(uuid())
  listingId String
  listing   Listing    @relation(fields: [listingId], references: [id])
  row       Int
  col       Int
  sellable  Boolean    @default(true)
  totalSqFt Decimal    @db.Decimal(14, 2)
  soldSqFt  Decimal    @default(0) @db.Decimal(14, 2)
  status    PlotStatus @default(AVAILABLE)
  updatedAt DateTime   @updatedAt

  holdings PlotHolding[]

  @@unique([listingId, row, col])
  @@map("plots")
}

// A buyer's fractional (sq-ft-precise) stake within a single plot/chunk —
// lets someone buy less than a whole chunk instead of being forced to take
// the entire cell.
model PlotHolding {
  id        String   @id @default(uuid())
  plotId    String
  plot      Plot     @relation(fields: [plotId], references: [id])
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  sqFt      Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  @@unique([plotId, ownerId])
  @@map("plot_holdings")
}

// Per-listing rollup of a user's total stake, kept in sync with PlotHolding
// inside the same transaction so the dashboard doesn't need to aggregate.
model Holding {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  sqFtOwned Decimal  @default(0) @db.Decimal(14, 2)
  plotCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([listingId, ownerId])
  @@map("holdings")
}

model Transaction {
  id               String            @id @default(uuid())
  listingId        String
  listing          Listing           @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User              @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sqFt             Decimal           @db.Decimal(14, 2)
  plotIds          String[]
  amount           Decimal           @db.Decimal(14, 2)
  status           TransactionStatus @default(PENDING)
  paymentMethod    String?
  txHash           String?
  blockchainStatus BlockchainStatus  @default(NOT_CONFIGURED)
  idempotencyKey   String?
  createdAt        DateTime          @default(now())

  // Postgres treats each NULL as distinct, so ordinary buys (no header sent)
  // are never deduplicated against each other — only repeats of the same
  // client-supplied key for the same buyer are.
  @@unique([buyerId, idempotencyKey])
  @@map("transactions")
}

// Synthetic historical price-per-sqft series per city, standing in for a
// real registry/market-data feed. Powers the simple trend/valuation model —
// linear regression over these points, not a trained ML model.
model AreaPriceHistory {
  id           String   @id @default(uuid())
  city         String
  period       String
  periodIndex  Int
  pricePerSqFt Float
  createdAt    DateTime @default(now())

  @@unique([city, period])
  @@map("area_price_history")
}
