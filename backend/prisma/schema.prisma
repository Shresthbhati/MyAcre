generator client {
  provider = "prisma-client-js"
}

// SQLite — zero external dependencies (no Postgres instance/credentials
// needed), so the app runs anywhere out of the box. Swap provider back to
// "postgresql" for a real deployment; nothing else in the schema is
// Postgres-specific (see the buy-transaction comment in listings.js for the
// one query that had to change alongside this).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TitleStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PlotStatus {
  AVAILABLE
  PARTIAL
  SOLD
  EXCLUDED
}

model User {
  id            String    @id @default(uuid())
  firebaseUid   String    @unique
  email         String    @unique
  name          String?
  kycStatus     KycStatus @default(UNVERIFIED)
  kycPan        String?
  walletAddress String?
  walletPrivateKeyEncrypted String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings     Listing[]     @relation("ListingOwner")
  holdings     Holding[]
  plotHoldings PlotHolding[]
  transactions Transaction[] @relation("TransactionBuyer")

  @@map("users")
}

model Listing {
  id                   String      @id @default(uuid())
  ownerId              String
  owner                User        @relation("ListingOwner", fields: [ownerId], references: [id])
  title                String
  description          String
  city                 String
  latitude             Float
  longitude            Float
  titleDeedNumber      String
  totalValue           Float
  areaSqFt             Float
  pricePerSqFt         Float
  totalTokens          Int
  pricePerToken        Float
  sqFtPerToken          Float
  gridRows             Int         @default(4)
  gridCols             Int         @default(5)
  imageSeed            String
  titleStatus          TitleStatus @default(PENDING)
  titleRejectionReason String?
  contractAddress      String?
  onChainTxHash        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  holdings     Holding[]
  plots        Plot[]
  transactions Transaction[]

  @@map("listings")
}

// One row per grid cell shown on the map. `sellable=false` (status EXCLUDED)
// marks cells that overlap roads / setbacks / common area — an owner draws
// these out when listing, and they're never purchasable.
model Plot {
  id        String     @id @default(uuid())
  listingId String
  listing   Listing    @relation(fields: [listingId], references: [id])
  row       Int
  col       Int
  sellable  Boolean    @default(true)
  totalSqFt Float
  soldSqFt  Float      @default(0)
  status    PlotStatus @default(AVAILABLE)
  updatedAt DateTime   @updatedAt

  holdings PlotHolding[]

  @@unique([listingId, row, col])
  @@map("plots")
}

// A buyer's fractional (sq-ft-precise) stake within a single plot/chunk —
// lets someone buy less than a whole chunk instead of being forced to take
// the entire cell.
model PlotHolding {
  id        String   @id @default(uuid())
  plotId    String
  plot      Plot     @relation(fields: [plotId], references: [id])
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  sqFt      Float
  updatedAt DateTime @updatedAt

  @@unique([plotId, ownerId])
  @@map("plot_holdings")
}

// Per-listing rollup of a user's total stake, kept in sync with PlotHolding
// inside the same transaction so the dashboard doesn't need to aggregate.
model Holding {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  sqFtOwned Float    @default(0)
  plotCount Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([listingId, ownerId])
  @@map("holdings")
}

model Transaction {
  id            String            @id @default(uuid())
  listingId     String
  listing       Listing           @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User              @relation("TransactionBuyer", fields: [buyerId], references: [id])
  sqFt          Float
  plotIds       Json              // array of plot ids — SQLite has no native array type, Prisma's Json field round-trips it fine
  amount        Float
  status        TransactionStatus @default(PENDING)
  paymentMethod String?
  txHash        String?
  createdAt     DateTime          @default(now())

  @@map("transactions")
}

// Synthetic historical price-per-sqft series per city, standing in for a
// real registry/market-data feed. Powers the simple trend/valuation model —
// linear regression over these points, not a trained ML model.
model AreaPriceHistory {
  id           String   @id @default(uuid())
  city         String
  period       String
  periodIndex  Int
  pricePerSqFt Float
  createdAt    DateTime @default(now())

  @@unique([city, period])
  @@map("area_price_history")
}
