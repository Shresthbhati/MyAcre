# Copy this file to .env and fill in real values. .env is git-ignored.

# A wallet private key (NOT your main wallet — use a fresh throwaway one for
# this testnet deployment) funded with a small amount of Amoy test MATIC.
# MetaMask: create a new account, switch to Polygon Amoy testnet, Account
# details > Export Private Key. Fund it free at https://faucet.polygon.technology
# (select "Polygon Amoy").
DEPLOYER_PRIVATE_KEY=

# Public RPC works fine for a hackathon demo — no key needed. Override only
# if you have your own (Alchemy/Infura) Amoy endpoint.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
